{
  "name": "@thiepn/chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-stockfish.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "visual:verify": "playwright test --config=playwright.config.ts",
    "ux:verify": "playwright test --config=playwright.ux.config.ts",
    "visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "visual:review:test": "node --test scripts/build-visual-review.test.mjs",
    "puzzles:build": "node scripts/build-puzzle-corpus.mjs",
    "predev": "npm run puzzles:ensure",
    "prebuild": "npm run puzzles:ensure && npm run puzzles:audit",
    "puzzles:production": "node scripts/build-puzzle-corpus.mjs scripts/data/lichess-production-baseline.csv --out public/data/puzzles --max-per-skill 250 --min-popularity 55 --min-plays 10 --min-rating 600 --max-rating 2400 --max-rd 220 --source-label \"Lichess CC0 production baseline\"",
    "puzzles:audit": "node scripts/audit-puzzle-corpus.mjs public/data/puzzles",
    "puzzles:ensure": "node scripts/ensure-puzzle-corpus.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "lock:audit": "node scripts/audit-dependency-lock.mjs",
    "release:audit": "node scripts/audit-release-artifact.mjs",
    "release:gate:test": "node --test scripts/release-approval.test.mjs",
    "design:audit": "node scripts/audit-material-system.mjs",
    "motion:audit": "node scripts/audit-motion-system.mjs",
    "mobile:audit": "node scripts/audit-mobile-native.mjs",
    "desktop:audit": "node scripts/audit-large-desktop.mjs",
    "a11y:audit": "node scripts/audit-accessibility.mjs",
    "theme:audit": "node scripts/audit-theme-customization.mjs",
    "content:audit": "node scripts/audit-visual-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
