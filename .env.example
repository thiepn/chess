# Browser publishable configuration, not a server credential.
# Production must use THIEPN Account (hycegznamzjhwinegaai).
# Configure GitHub repository variables CHESS_SUPABASE_URL and
# CHESS_SUPABASE_PUBLISHABLE_KEY for Deploy Pages.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only after the one-time, MANUAL public OAuth client registration in THIEPN Account.
# Chess uses the canonical upstream Account PKCE SDK, never direct Google OAuth.
# GitHub repository variable: CHESS_OAUTH_CLIENT_ID
VITE_THIEPN_ACCOUNT_CLIENT_ID=
VITE_THIEPN_ACCOUNT_REDIRECT_URI=https://chess.thiepn.dev/auth/callback/
